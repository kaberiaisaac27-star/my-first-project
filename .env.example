# API-Sports direct dashboard key; NOT a RapidAPI key. Never paste it into chat.
API_FOOTBALL_KEY=
# 900 seconds: at most about 96 provider calls/day per server if continuously used.
FIXTURE_POLL_SECONDS=900
# today = fixtures and scores for today's UTC date; live = live matches only.
FIXTURE_MODE=today
PORT=3000

# Shared rolling 24-hour cap, including failed requests; leaves 10 free-plan requests.
FIXTURE_REQUEST_BUDGET=90
